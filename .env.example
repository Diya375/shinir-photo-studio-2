# Copy to .env and fill in. NEVER commit .env
PORT=4000
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=admin@shinirphotostudio.com
ADMIN_PASSWORD=
DB_PATH=server/data/studio.db
# Booking hours (24h): slots every hour from START until END
SLOT_START=9
SLOT_END=18
# Closed weekdays, 0=Sunday ... 6=Saturday
CLOSED_DAYS=6
